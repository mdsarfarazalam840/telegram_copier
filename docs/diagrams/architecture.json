  "cards": [
    {
      "dot": "emerald",
      "title": "Runtime path",
      "items": [
        "Sources are read by message timestamp inside LOOKBACK_MINUTES",
        "COPY_MODE=copy posts as the channel itself; forward restores attribution",
        "Flood wait halts the run instead of dropping the checkpoint"
      ]
    },
    {
      "dot": "amber",
      "title": "State and idempotency",
      "items": [
        "state_key=global holds per-source last_id and a recent ID window",
        "Cursor gate plus recent dedupe prevent duplicate pushes",
        "Oversized payloads compact before save to fit the row limit"
      ]
    },
    {
      "dot": "cyan",
      "title": "Control and observability",
      "items": [
        "Relayroom reads Appwrite with a project-user session, never an API key",
        "Manual runs call Functions.createExecution asynchronously",
        "GitHub Actions deploys only after pytest passes on main"
      ]
    }
  ]
